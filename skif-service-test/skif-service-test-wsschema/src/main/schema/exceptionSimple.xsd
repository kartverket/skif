<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/skiftest/wsapi/exception"
        xmlns:excns="http://skif.statkart.no/skiftest/wsapi/exception"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <xs:element name="SimpleException" nillable="true" type="excns:SimpleFaultInfo"/>

    <xs:complexType name="SimpleFaultInfo">
        <xs:sequence>
            <xs:element name="infoField" type="xs:string" nillable="true"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="SimpleNonMappedException" nillable="true" type="excns:SimpleNonMappedFaultInfo"/>

    <xs:complexType name="SimpleNonMappedFaultInfo">
        <xs:sequence>
            <xs:element name="infoField" type="xs:string" nillable="true"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>