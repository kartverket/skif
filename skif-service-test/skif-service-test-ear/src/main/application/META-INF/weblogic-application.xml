<?xml version='1.0' encoding='UTF-8'?>
<weblogic-application xmlns="http://xmlns.oracle.com/weblogic/weblogic-application"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://xmlns.oracle.com/weblogic/weblogic-application http://xmlns.oracle.com/weblogic/weblogic-application/1.0/weblogic-application.xsd">
    <security>
        <security-role-assignment>
            <role-name>Innsyn</role-name>
            <principal-name>Innsyn</principal-name>
        </security-role-assignment>
    </security>
    <prefer-application-packages>
        <package-name>antlr.*</package-name>
        <package-name>org.slf4j.*</package-name>
    </prefer-application-packages>
    <prefer-application-resources>
        <resource-name>META-INF/services/com.sun.xml.ws.spi.db.BindingContextFactory</resource-name>
        <resource-name>META-INF/services/javax.xml.bind.JAXBContext</resource-name>
    </prefer-application-resources>
</weblogic-application>
