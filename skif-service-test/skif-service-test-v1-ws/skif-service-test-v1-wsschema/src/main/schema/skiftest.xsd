<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/skiftest/wsapi/domain"
        xmlns:skiftestns="http://skif.statkart.no/skiftest/wsapi/domain"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <xs:complexType name="A">
        <xs:sequence>
            <xs:element name="text" type="xs:string" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="skiftestns:A"/>
        </xs:sequence>
    </xs:complexType>


    <xs:complexType name="B">
        <xs:sequence>
            <xs:element name="text" type="xs:string" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StringList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="IntList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="C">
        <xs:sequence>
            <xs:element name="ints" type="skiftestns:IntList" minOccurs="1" maxOccurs="1"/>
            <xs:element name="strings" type="skiftestns:StringList" minOccurs="1" maxOccurs="1"/>
            <xs:element name="as" type="skiftestns:AList" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="M">
        <xs:sequence>
            <xs:element name="mapOfAs" type="skiftestns:AMap" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary xmlns="http://schemas.microsoft.com/2003/10/Serialization/">true</IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="xs:string"/>
                        <xs:element name="value" type="skiftestns:AList"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Timestamp">
        <xs:sequence>
            <xs:element name="timestamp" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalTime">
        <xs:sequence>
            <xs:element name="time" type="xs:time"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalDate">
        <xs:sequence>
            <xs:element name="date" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalDateTime">
        <xs:sequence>
            <xs:element name="dateTime" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DatesAndTimes">
        <xs:sequence>
            <xs:element name="timestamp" type="skiftestns:Timestamp"/>
            <xs:element name="localDate" type="skiftestns:LocalDate"/>
            <xs:element name="localTime" type="skiftestns:LocalTime"/>
            <xs:element name="localDateTime" type="skiftestns:LocalDateTime"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
