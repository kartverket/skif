pipeline {
    agent {
        node {
            label 'SKIF'
            customWorkspace "workspace/${JOB_NAME}"
        }
    }
    parameters {
        string(name: 'SUBVERSION')
    }
    environment {
        GRADLE_OPTS = '-Dorg.gradle.daemon=false'
        GRADLE_USER_HOME = "${env.WORKSPACE}/.gradle"
        SKIF_VERSION = "${env.BRANCH_NAME}.${params.SUBVERSION}"
        GRADLE_ARGS = "-Pversion=$SKIF_VERSION -Pdb_hostname=nnridb009 -Pdb_service=MA02TST.statkart.no -Pdb_username=J_ANNET_${env.EXECUTOR_NUMBER} -Pusername=J_ANNET_${env.EXECUTOR_NUMBER} -Ppassword=J_ANNET_${env.EXECUTOR_NUMBER} -PWEBLOGIC_HOME=${env.'WEBLOGIC_HOME_12.1.3.0'} -PWEBLOGIC_VERSION=12.1.3"

        //for publisering til sentralt maven repo bines opp via jenkins credential (secret text)
        MAVEN_PUBLISH = credentials('MAVEN_DEPLOY_RELEASES')
    }
    tools {
        jdk 'Java 8 Latest'
    }
    stages {
        stage('Build') { 
            steps {
                bat "exit 1"
                bat "gradlew clean assemble ${GRADLE_ARGS}"
            }
        }
        stage('Test') { 
            steps {
                bat "gradlew dbInit check ${GRADLE_ARGS}"
            }
        }
        stage('Deploy') { 
            steps {
                bat "gradlew publish ${GRADLE_ARGS} --init-script gradle/scripts/mavenPublish.gradle"
            }
        }
    }
    post {
        always {
            step([$class: 'Publisher', reportFilenamePattern: '**/build/reports/tests/testng-results.xml'])
        }
        success {
            echo "Husk å kjøre 'git tag ${SKIF_VERSION} ${env.GIT_COMMIT}'"
        }
    }
}
