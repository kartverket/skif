<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest2.domain.eierskap.Eier" select-before-update="true" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest2.persistence.hibernate.type.EierIdType">
            <generator class="assigned"/>
        </id>

        <set name="eiendommer" table="EiendomForEier">
            <meta attribute="bubble-ref"/>
            <key column="eierId"/>
            <many-to-many class="no.statkart.skif.storetest2.domain.eierskap.Eiendom" column="eiendomId" foreign-key="FK_Eier_Eiendom"/>
        </set>
    </class>

</hibernate-mapping>
