<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/storetest/wsapi/domain"
        xmlns:domainns="http://skif.statkart.no/storetest/wsapi/domain"
        xmlns:basetyperns="http://skif.statkart.no/storetest/wsapi/domain/basetyper"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <xs:import schemaLocation="basetyper.xsd" namespace="http://skif.statkart.no/storetest/wsapi/domain/basetyper"/>

    <xs:complexType name="InverseRelation">
        <xs:sequence>
            <xs:element name="materialised" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Komentar: Definisjoner som må finnes for hver BubbleId subtype -->
    <xs:complexType name="StoreTestBubbleId">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="domainns:StoreTestBubbleId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdInverseRelation">
        <xs:complexContent>
            <xs:extension base="domainns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" type="domainns:StoreTestBubbleId"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdListInverseRelation">
        <xs:complexContent>
            <xs:extension base="domainns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" type="domainns:StoreTestBubbleIdList"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- Kommentar slutt -->

    <xs:complexType name="SnapshotVersionToStoreTestBubbleIdMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" type="basetyperns:Timestamp"/>
                        <xs:element name="value" type="domainns:StoreTestBubbleId"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdToSnapshotBubbleIdsMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="domainns:StoreTestBubbleId"/>
                        <xs:element name="value" type="domainns:SnapshotVersionToStoreTestBubbleIdMap"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubble">
        <xs:sequence>
            <xs:element name="id" type="domainns:StoreTestBubbleId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="domainns:StoreTestBubble"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AbstractStoreTestBubbleWithHistoryId">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubbleId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="AbstractStoreTestBubbleWithHistory">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubble">
                <xs:sequence>
                    <xs:element name="oppdateringsdato" type="basetyperns:Timestamp"/>
                    <xs:element name="sluttdato" type="basetyperns:Timestamp"/>
                    <xs:element name="versjonId" type="xs:long"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="AbstractEntityComponentWithHistory">
        <xs:sequence>
            <xs:element name="oppdateringsdato" type="basetyperns:Timestamp"/>
            <xs:element name="sluttdato" type="basetyperns:Timestamp"/>
            <xs:element name="versjonId" type="xs:long"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestContext">
        <xs:sequence>
            <xs:element name="systemVersion" type="xs:string"/>
            <xs:element name="locale" type="xs:string"/>
            <xs:element name="snapshotVersion" type="basetyperns:Timestamp"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreBubbleTransfer">
        <xs:sequence>
            <xs:element name="bubbleObjects" type="domainns:StoreTestBubbleList"/>
            <xs:element name="lockedIds" type="domainns:StoreTestBubbleIdList"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="UnitOfWorkTransfer">
        <xs:sequence>
            <xs:element name="insertedObjects" type="domainns:StoreTestBubbleList"/>
            <xs:element name="updatedObjects" type="domainns:StoreTestBubbleList"/>
            <xs:element name="deletedObjects" type="domainns:StoreTestBubbleList"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TestNumber">
        <xs:sequence>
            <xs:element name="offset" type="xs:int"/>
            <xs:element name="number" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MockupTransfer">
        <xs:complexContent>
            <xs:extension base="domainns:UnitOfWorkTransfer">
                <xs:sequence>
                    <xs:element name="testNumber" type="domainns:TestNumber"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="MockupSnapshotMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="basetyperns:Timestamp"/>
                        <xs:element name="value" type="domainns:MockupTransfer"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>


</xs:schema>