<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/storetest/wsapi/service/testmapping"
        xmlns="http://skif.statkart.no/storetest/wsapi/service/testmapping"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">


    <!-- ================================================= -->
    <!-- Skjema for testing av mapping                     -->
    <!-- ================================================= -->


    <xs:complexType name="DateTimeDemo">
        <xs:sequence>
            <xs:element name="dateAndTime" type="xs:dateTime" minOccurs="0" />
            <xs:element name="date" type="xs:date" minOccurs="0" />
            <xs:element name="time" type="xs:time" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DateTimeList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="DateTimeDemo"/>
        </xs:sequence>
    </xs:complexType>



    <xs:simpleType name="timestamp">
        <xs:restriction base="xs:dateTime">
            <xs:minExclusive value="-0001-12-31T00:00:00.000000000"/>
            <!--<xs:minInclusive value="2000-01-01T00:00:00.000000000"/>-->
            <xs:maxInclusive value="9999-01-01T00:00:00.000000000"/>
            <!--<xs:pattern value=".{10}"/>-->
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="time">
        <xs:restriction base="xs:time">
            <xs:pattern value="\d\d:\d\d:\d\d"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="date">
        <xs:restriction base="xs:date">
            <xs:minExclusive value="-0001-12-31"/>
            <xs:maxExclusive value="3000-01-01"/>
            <!--<xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>-->
            <!--<xs:pattern value="\d{4}-\d\d-\d\d"/>-->
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="DateTimeDemoCustomType">
        <xs:sequence>
            <xs:element name="dateAndTime" type="timestamp" minOccurs="0" />
            <xs:element name="date" type="date" minOccurs="0" />
            <xs:element name="time" type="time" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DateTimeDemoCustomTypeList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="DateTimeDemoCustomType"/>
        </xs:sequence>
    </xs:complexType>


</xs:schema>
