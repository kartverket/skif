<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/storetest/wsapi/domain/relation/uni/direct"
        xmlns:relationdirectns="http://skif.statkart.no/storetest/wsapi/domain/relation/uni/direct"
        xmlns:basicns="http://skif.statkart.no/storetest/wsapi/domain/basic"
        xmlns:domainns="http://skif.statkart.no/storetest/wsapi/domain"
        xmlns:basetyperns="http://skif.statkart.no/storetest/wsapi/domain/basetyper"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <xs:import schemaLocation="demoKoder.xsd" namespace="http://skif.statkart.no/storetest/wsapi/domain/demo/koder"/>
    <xs:import schemaLocation="domain.xsd" namespace="http://skif.statkart.no/storetest/wsapi/domain"/>
    <xs:import schemaLocation="basic.xsd" namespace="http://skif.statkart.no/storetest/wsapi/domain/basic"/>
    <xs:import schemaLocation="basetyper.xsd" namespace="http://skif.statkart.no/storetest/wsapi/domain/basetyper"/>


    <xs:complexType name="X1AAId">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubbleId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="X1AAIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="relationdirectns:X1AAId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="X1AAIdInverseRelation">
        <xs:complexContent>
            <xs:extension base="domainns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" type="relationdirectns:X1AAId"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="X1AAIdListInverseRelation">
        <xs:complexContent>
            <xs:extension base="domainns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" type="relationdirectns:X1AAIdList"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <xs:complexType name="X1AA">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubble">
                <xs:sequence>
                    <xs:element name="nr"  type="xs:int"/>
                    <xs:element name="text" type="xs:string"/>
                    <xs:element name="someBBId" type="relationdirectns:X1BBOneId"/>
                    <xs:element name="someCCsIds" type="relationdirectns:X1CCManyIdList"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="X1AAIdListForX1BBOneIdMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="relationdirectns:X1BBOneId"/>
                        <xs:element name="value" type="relationdirectns:X1AAIdList"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="X1AAIdForX1CCManyIdMap">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="relationdirectns:X1CCManyId"/>
                        <xs:element name="value" type="relationdirectns:X1AAId"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>


    <xs:complexType name="X1BBOneId">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubbleId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="X1BBOneIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="relationdirectns:X1BBOneId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="X1BBOne">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubble">
                <xs:sequence>
                    <xs:element name="nr"  type="xs:int"/>
                    <xs:element name="text" type="xs:string"/>
                    <xs:element name="invSomeBBIds" type="relationdirectns:X1AAIdListInverseRelation"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <xs:complexType name="X1CCManyId">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubbleId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="X1CCManyIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="relationdirectns:X1CCManyId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="X1CCMany">
        <xs:complexContent>
            <xs:extension base="domainns:StoreTestBubble">
                <xs:sequence>
                    <xs:element name="nr"  type="xs:int"/>
                    <xs:element name="text" type="xs:string"/>
                    <xs:element name="invSomeCCsId" type="relationdirectns:X1AAIdInverseRelation"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>
