<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

   <class name="no.statkart.skif.storetest.domain.standalone.ParentBubble" lazy="true" select-before-update="true">
      <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.standalone.ParentBubbleIdType">
          <generator class="assigned"/>
      </id>

      <property name="text"/>

       <set name="childForParents" access="field" lazy="true" batch-size="256" cascade="all-delete-orphan,evict" inverse="true">
          <key column="parentBubbleId"/>
          <one-to-many  class="no.statkart.skif.storetest.domain.standalone.ChildForParent"/>
       </set>
   </class>

    <class name="no.statkart.skif.storetest.domain.standalone.ChildForParent"  table="childforparent" lazy="true" select-before-update="true">
       <id name="id" column="id">
          <generator class="assigned" />
       </id>
       <many-to-one  name="parentBubble" class="no.statkart.skif.storetest.domain.standalone.ParentBubble"
                    column="parentBubbleId"/>
        <property name="childBubbleId"
                  type="no.statkart.skif.storetest.persistence.hibernate.type.standalone.ChildBubbleIdType"/>
    </class>


</hibernate-mapping>
