<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.koder.BDbKode" table="BKode" >
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.kodeliste.BDbKodeIdType">
            <generator class="assigned"/>
        </id>

        <property name="kodeverdi"/>

        <map name="lokalisertBeskrivelse" table="BKodeLoc">
            <key column="id"/>
            <map-key type="string" column="lokale"/>
            <element column="beskrivelse" type="string"/>
        </map> 

    </class>

</hibernate-mapping>
