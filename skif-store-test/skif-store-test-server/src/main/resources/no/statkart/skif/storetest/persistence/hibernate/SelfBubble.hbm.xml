<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

   <class name="no.statkart.skif.storetest.domain.demo.SelfBubble" select-before-update="true">
      <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.SelfBubbleIdType">
          <generator class="assigned"/>
      </id>

      <property name="text"/>

       <many-to-one
          name="ref"
          column="refId"
          class="no.statkart.skif.storetest.domain.demo.SelfBubble">
          <meta attribute="bubble-ref"/>
       </many-to-one>

   </class>

</hibernate-mapping>
