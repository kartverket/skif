<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.component.historikk.HistorikkBubbleWithListEntityComponents" table="HIST_BUBBLE_W_LENTITIES" select-before-update="true" lazy="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.component.historikk.ListOfEntityComponentsIdType">
            <generator class="assigned"/>
        </id>

        <property name="oppdateringsdato" type="timestamp"/>
        <property name="sluttdato" type="timestamp"/>
        <property name="versjonId"/>

        <list name="entityComponents" cascade="all-delete-orphan,evict">
            <key column="listOfEntityComponentsId" foreign-key="FK_LIST_OF_ENTITY_COMPONENTS"/>
            <index column="listIndex"/>
            <one-to-many class="no.statkart.skif.storetest.domain.component.historikk.HistorikkListEntityComponent"/>
        </list>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.historikk.HistorikkListEntityComponent" table="HIST_LENTITY_COMPONENT" select-before-update="true">
        <id name="id" column="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <property name="oppdateringsdato" type="timestamp"/>
        <property name="sluttdato" type="timestamp"/>
        <property name="versjonId"/>

        <property name="textValue"/>
    </class>

</hibernate-mapping>
