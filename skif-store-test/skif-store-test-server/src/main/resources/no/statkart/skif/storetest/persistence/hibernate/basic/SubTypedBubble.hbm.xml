<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.basic.SubTypedBubble" table="SUBTYPEDBUBBLE" select-before-update="true" discriminator-value="abstract" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.basic.SubTypedBubbleIdType">
            <generator class="assigned"/>
        </id>

        <discriminator column="class" type="string"/>

        <property name="text"/>

        <subclass name="no.statkart.skif.storetest.domain.basic.SubTypeWithPrimitive" discriminator-value="SubTypeWithPrimitive" lazy="true">
            <property name="num"/>
        </subclass>
        <subclass name="no.statkart.skif.storetest.domain.basic.SubTypeWithCollection" discriminator-value="SubTypeWithCollection" lazy="true">
            <set name="tekster" table="TEKSTFORSUBTYPE" lazy="true" batch-size="256">
                <key column="subtypedid"/>
                <element column="tekst" type="string" not-null="true"/>
            </set>
        </subclass>
    </class>

</hibernate-mapping>
