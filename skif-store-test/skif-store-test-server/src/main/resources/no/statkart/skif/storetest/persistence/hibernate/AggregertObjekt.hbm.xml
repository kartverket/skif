<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.AggregertObjekt" table="AggregertObjekt">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.AggregertObjektIdType">
            <generator class="assigned"/>
        </id>

        <property name="tekst"/>

        <list name="komponenter" cascade="all-delete-orphan" table="AggregertKomponent" access="field">
            <key column="id"/>
            <list-index column="indeks"/>
            <composite-element class="no.statkart.skif.storetest.domain.demo.AggregertKomponent">
                <parent name="aggregertObjekt"/>
                <property name="noe"/>
                <property name="annet"/>
            </composite-element>
        </list>

        <join table="AggregertObjektMeta">
            <key column="id"/>
            <property name="sistOppdatertAv"/>
            <property name="sistOppdatert"/>
        </join>

    </class>

</hibernate-mapping>
