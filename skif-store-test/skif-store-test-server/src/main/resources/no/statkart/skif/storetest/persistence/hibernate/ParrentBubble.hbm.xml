<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

   <class name="no.statkart.skif.storetest.domain.demo.ParrentBubble" lazy="true" select-before-update="true">
      <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.ParrentBubbleIdType">
          <generator class="assigned"/>
      </id>

      <property name="text"/>

       <set name="childForParrents" access="field" lazy="true" batch-size="256" cascade="all-delete-orphan,evict" inverse="true">
          <key column="parrentBubbleId"/>
          <one-to-many  class="no.statkart.skif.storetest.domain.demo.ChildForParrent"/>
       </set>
   </class>

    <class name="no.statkart.skif.storetest.domain.demo.ChildForParrent"  table="childforparrent" lazy="true" select-before-update="true">
       <id name="id" column="id">
          <generator class="assigned" />
       </id>
       <many-to-one  name="parrentBubble" class="no.statkart.skif.storetest.domain.demo.ParrentBubble"
                    column="parrentBubbleId"/>
       <many-to-one
             name="childBubble"
             column="childBubbleId"
             class="no.statkart.skif.storetest.domain.demo.ChildBubble"
             foreign-key="FK_CHILDFORPARRENT_CHILD">
          <meta attribute="bubble-ref"/>
       </many-to-one>
    </class>


</hibernate-mapping>
