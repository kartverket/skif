<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.tinglysing.RettsstiftelsestypeKode" table="RettsstiftelsestypeKode" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.tinglysing.RettsstiftelsestypeKodeIdType">
            <generator class="assigned"/>
        </id>

        <many-to-one
              name="rettstypeKodeId"
              column="rettstypeKodeId"
              class="no.statkart.skif.storetest.domain.tinglysing.RettstypeKode"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_RetKode_RettstypeKode">
           <meta attribute="bubble-ref"/>
        </many-to-one>

        <property name="kodeverdi"/>

        <map name="localizedFieldsMap" table="RettsstiftelsestypeKodeLoc" lazy="true" fetch="join">
            <key column="id"/>
            <map-key type="string" column="lokale"/>
            <composite-element class="no.statkart.skif.store.kodeliste.Kode$LocalizedFields">
                <property name="navn" type="string" access="field"/>
                <property name="beskrivelse" type="string" access="field"/>
           </composite-element>
        </map>

    </class>

</hibernate-mapping>
