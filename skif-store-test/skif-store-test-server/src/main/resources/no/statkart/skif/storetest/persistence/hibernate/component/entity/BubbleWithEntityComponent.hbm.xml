<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.component.entity.BubbleWithEntityComponent"
           select-before-update="true" lazy="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.component.entity.BubbleWithEntityComponentIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="text"/>
        <many-to-one
                name="level1Component"
                column="level1ComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.Level1EntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>
        <set name="aaComponentsSet" lazy="true" cascade="all-delete-orphan,evict" batch-size="256">
            <key column="ownerId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.component.entity.SetAaEntityComponent"/>
        </set>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.entity.Level1EntityComponent" lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>
        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.component.entity.BubbleWithEntityComponent"
                access="field"
                cascade="none">

        </many-to-one>

        <property name="text"/>
        <many-to-one
                name="level2Component"
                column="level2ComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.Level2EntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">

        </many-to-one>

        <component name="beloep" class="no.statkart.skif.storetest.domain.basic.BeloepValueObject" unique="true">
            <property name="valuta"/>
            <property name="verdi"/>
            <property name="kommentar"/>
        </component>
        <set name="beloepSet" table="EntityL1BeloepVOSet" cascade="all-delete-orphan" lazy="true" batch-size="25" access="field">
            <key column="ownerId"/>
            <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                <property name="valuta" not-null="true"/>
                <property name="verdi" not-null="true"/>
                <property name="kommentar"/>
            </composite-element>
        </set>
    </class>
    <class name="no.statkart.skif.storetest.domain.component.entity.Level2EntityComponent" lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.component.entity.Level1EntityComponent"
                access="field"
                cascade="none">
        </many-to-one>

        <property name="text"/>
        <component name="beloep" class="no.statkart.skif.storetest.domain.basic.BeloepValueObject" unique="true">
            <property name="valuta"/>
            <property name="verdi"/>
            <property name="kommentar"/>
        </component>
        <set name="beloepSet" table="EntityL2BeloepVOSet" cascade="all-delete-orphan" lazy="true"
             batch-size="25" access="field">
            <key column="ownerId"/>
            <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                <property name="valuta" not-null="true"/>
                <property name="verdi" not-null="true"/>
                <property name="kommentar"/>
            </composite-element>
        </set>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.entity.SetAaEntityComponent" table="SetAaEntityComp"
           lazy="true" select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>
        <property name="ident"/>
        <property name="text"/>

        <!-- readonly tilbakepeker som settes av one-to-many collection mapping i owner  -->
        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.component.entity.BubbleWithEntityComponent"
                access="field"
                update="false"
                insert="false"
                cascade="none">
        </many-to-one>

        <many-to-one
                name="level1Component"
                column="level1ComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.SetAaLevel1EntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>
        <set name="beloepSet" table="SetAaEntityBeloepVOSet" cascade="all-delete-orphan" lazy="true"
             batch-size="25" access="field">
            <key column="ownerId"/>
            <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                <property name="valuta" not-null="true"/>
                <property name="verdi" not-null="true"/>
                <property name="kommentar"/>
            </composite-element>
        </set>
        <many-to-one
                name="nestedComponent"
                column="nestedComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.NestedEntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.entity.SetAaLevel1EntityComponent"
           table="SetAaL1EntityComp" lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.component.entity.SetAaEntityComponent"
                access="field"
                cascade="none">
        </many-to-one>
        <property name="text"/>

        <many-to-one
                name="level2Component"
                column="level2ComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.SetAaLevel2EntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>

        <set name="beloepSet" table="SetAaL1EntBeloepVOSet" cascade="all-delete-orphan" lazy="true"
             batch-size="25" access="field">
            <key column="ownerId"/>
            <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                <property name="valuta" not-null="true"/>
                <property name="verdi" not-null="true"/>
                <property name="kommentar"/>
            </composite-element>
        </set>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.entity.SetAaLevel2EntityComponent"
           table="SetAaL2EntityComp" lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.component.entity.SetAaLevel1EntityComponent"
                access="field"
                cascade="none">
        </many-to-one>

        <property name="text"/>
        <set name="beloepSet" table="SetAaL2EntBeloepVOSet" cascade="all-delete-orphan" lazy="true"
             batch-size="25" access="field">
            <key column="ownerId"/>
            <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                <property name="valuta" not-null="true"/>
                <property name="verdi" not-null="true"/>
                <property name="kommentar"/>
            </composite-element>
        </set>
    </class>

    <class name="no.statkart.skif.storetest.domain.component.entity.NestedEntityComponent" table="NestedEntityComp"
           lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <property name="text"/>
        <many-to-one
                name="nestedComponent"
                column="nestedComponentId"
                class="no.statkart.skif.storetest.domain.component.entity.NestedEntityComponent"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>

        <set name="nestedComponents" lazy="true" cascade="all-delete-orphan,evict" batch-size="256" access="field">
            <key column="ownerId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.component.entity.NestedEntityComponent"/>
        </set>
    </class>
</hibernate-mapping>
