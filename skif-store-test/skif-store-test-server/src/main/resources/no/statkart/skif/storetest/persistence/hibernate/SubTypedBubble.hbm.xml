<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.SubTypedBubble" select-before-update="true" discriminator-value="abstract" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.SubTypedBubbleIdType">
            <generator class="assigned"/>
        </id>

        <discriminator column="class" type="string"/>

        <property name="text"/>

        <subclass name="no.statkart.skif.storetest.domain.demo.SubTypeWithPrimitive" discriminator-value="SubTypeWithPrimitive" lazy="true">
            <property name="num"/>
        </subclass>
        <subclass name="no.statkart.skif.storetest.domain.demo.SubTypeWithCollection" discriminator-value="SubTypeWithCollection" lazy="true">
            <set name="aEnumKoderIds" table="AKodeForSubtype">
                <key column="subtypedid"/>
                <element column="kodeid" type="Demo_AEnumKodeIdType" not-null="true"/>
            </set>
        </subclass>
    </class>

</hibernate-mapping>
