<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain2.TestDbKodelisteImpl2" table="Kodeliste">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence2.hibernate.type.kodeliste.TestDbKodelisteIdType2">
            <generator class="assigned"/>
        </id>

        <property name="kodeClass" column="kodeClassname" type="org.hibernate.type.ClassType"/>

        <map name="lokalisertBeskrivelse" table="KodelisteLoc">
            <key column="id"/>
            <map-key type="string" column="lokale"/>
            <element column="beskrivelse" type="string"/>
        </map> 

    </class>

</hibernate-mapping>
