<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false" >

    <class name="no.statkart.skif.storetest.domain.basic.BubbleWithRelation" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.basic.BubbleWithRelationIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="text"/>

        <many-to-one
                name="simple"
                column="simpleId"
                class="no.statkart.skif.storetest.domain.basic.Simple">
            <meta attribute="bubble-ref"/>
        </many-to-one>

    </class>
</hibernate-mapping>
