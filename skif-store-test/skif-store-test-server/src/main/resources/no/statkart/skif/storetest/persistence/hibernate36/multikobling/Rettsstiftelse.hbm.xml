<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.multikobling_old.Rettsstiftelse" lazy="true" abstract="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.multikobling.RettsstiftelseIdType">
            <generator class="assigned"/>
        </id>

        <discriminator column="class"/>

        <set name="personKoblinger" table="Rettsstiftelse_Person_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.multikobling_old.kobling.RetttstiftelseTilPersonKobling">
                <property name="rolle">
                    <type name="org.hibernate.type.EnumType">
                        <param name="enumClass">no.statkart.skif.storetest.domain.multikobling_old.kobling.RettsstiftelsePersonRolle</param>
                        <param name="useNamed">true</param>
                    </type>
                </property>

                <many-to-one
                      name="person"
                      column="personId"
                      class="no.statkart.skif.storetest.domain.multikobling_old.Person"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Rettsstift_Person">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

        <subclass name="no.statkart.skif.storetest.domain.multikobling_old.Servitutt" discriminator-value="Servitutt" lazy="true">
        </subclass>

        <subclass name="no.statkart.skif.storetest.domain.multikobling_old.Pengeheftelse" discriminator-value="Pengeheftelse" lazy="true">
        </subclass>
    </class>

</hibernate-mapping>
