<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false" >

    <class name="no.statkart.skif.storetest.domain.component.composite.BubbleWithCompositeComponent" select-before-update="true" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.component.composite.BubbleWithCompositeComponentIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="text"/>

        <component name="level1Component" class="no.statkart.skif.storetest.domain.component.composite.Level1CompositeComponent" unique="true">
            <property name="text" column="l1_text"/>
            <component name="beloep" class="no.statkart.skif.storetest.domain.basic.BeloepValueObject" unique="true">
                <property name="valuta" column="l1_valuta"/>
                <property name="verdi" column="l1_verdi"/>
                <property name="kommentar" column="l1_kommentar"/>
            </component>
            <set name="beloepSet" table="CompositeL1BeloepVOSet" cascade="all-delete-orphan" lazy="false" batch-size="25" access="field">
                <key column="ownerId"/>
                <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                    <property name="valuta" not-null="true"/>
                    <property name="verdi" not-null="true"/>
                    <property name="kommentar"/>
                </composite-element>
            </set>
            <component name="level2Component" class="no.statkart.skif.storetest.domain.component.composite.Level2CompositeComponent" unique="true">
                <property name="text" column="l2_text"/>
                <component name="beloep" class="no.statkart.skif.storetest.domain.basic.BeloepValueObject" unique="true">
                    <property name="valuta" column="l2_valuta"/>
                    <property name="verdi" column="l2_verdi"/>
                    <property name="kommentar" column="l2_kommentar"/>
                </component>
                <set name="beloepSet" table="CompositeL2BeloepVOSet" cascade="all-delete-orphan" lazy="false" batch-size="25" access="field">
                    <key column="ownerId"/>
                    <composite-element class="no.statkart.skif.storetest.domain.basic.BeloepValueObject">
                        <property name="valuta" not-null="true"/>
                        <property name="verdi" not-null="true"/>
                        <property name="kommentar"/>
                    </composite-element>
                </set>
            </component>
        </component>
    </class>
</hibernate-mapping>
