<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.mockup.Raz" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.RazIdType">
            <generator class="assigned"/>
        </id>

        <property name="text"/>

        <component name="razComponent" class="no.statkart.skif.storetest.domain.mockup.RazComponent">
            <property name="fooId"
                      type="no.statkart.skif.storetest.persistence.hibernate.type.mockup.FooIdType"/>

            <property name="compText"/>
        </component>

        <many-to-one name="razEntityComponent" column="razEntityComponentId" unique="true" cascade="all-delete-orphan"/>
    </class>

    <class name="no.statkart.skif.storetest.domain.mockup.RazEntityComponent" select-before-update="true">
        <id name="id" column="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <property name="componentName"/>
    </class>


</hibernate-mapping>
