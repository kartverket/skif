<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.BubbleWithComponents">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.BubbleWithComponentsIdType">
            <generator class="assigned"/>
        </id>

        <set name="components" lazy="true" cascade="all-delete-orphan,evict" batch-size="256" access="field">
            <key column="bubbleId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.demo.BubbleWithComponentsComponent"/>
        </set>
    </class>

    <class name="no.statkart.skif.storetest.domain.demo.BubbleWithComponentsComponent" lazy="true" select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>
        <property name="text"/>
    </class>
</hibernate-mapping>
