<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.BarFoos">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.BarFoosIdType">
            <generator class="assigned"/>
        </id>

        <property name="text"/>
        <many-to-one
                name="bar"
                column="barId"
                class="no.statkart.skif.storetest.domain.mockup.Bar">
            <meta attribute="bubble-ref"/>
        </many-to-one>

        <set name="foo" table="FooForBarFoos" lazy="true" batch-size="4" access="field">
            <meta attribute="bubble-ref"/>
            <key column="barFoosId"/>
            <many-to-many
                    class="no.statkart.skif.storetest.domain.mockup.Foo"
                    column="fooId"/>
        </set>
    </class>

</hibernate-mapping>
