<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.BarFoos">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.BarFoosIdType">
            <generator class="assigned"/>
        </id>

        <property name="text"/>
        <property name="barId"
                  type="no.statkart.skif.storetest.persistence.hibernate.type.mockup.BarIdType"/>

        <set name="fooIds" table="FooForBarFoos" lazy="true" batch-size="4" access="field">
            <key column="barFoosId"/>
            <element column="fooId"
                     type="no.statkart.skif.storetest.persistence.hibernate.type.mockup.FooIdType"/>
        </set>
    </class>

</hibernate-mapping>
