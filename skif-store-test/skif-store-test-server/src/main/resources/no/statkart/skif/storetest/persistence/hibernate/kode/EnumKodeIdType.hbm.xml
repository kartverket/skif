<?xml version="1.0" encoding="UTF-8" ?>
<!--  Mapping av koder. Hver enummerert kode må mappes til egen hibernate type.
      Navnekonvensjon på type navn er Pakkenavn_KlassenavnForEnumKodeType.
   -->
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

   <typedef class="no.statkart.skif.store.persistence.hibernate.type.EnumKodeIdType" name="Demo_AEnumKodeIdType">
      <param name="enumClassName">no.statkart.skif.storetest.domain.demo.koder.AEnumKodeId</param>
   </typedef>

</hibernate-mapping>
