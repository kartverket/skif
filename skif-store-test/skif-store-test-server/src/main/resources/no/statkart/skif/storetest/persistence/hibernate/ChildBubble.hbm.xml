<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

   <class name="no.statkart.skif.storetest.domain.demo.ChildBubble" lazy="true">
      <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.ChildBubbleIdType">
          <generator class="assigned"/>
      </id>

      <property name="text"/>

       <many-to-one
          name="testBubble"
          column="testBubbleId"
          class="no.statkart.skif.storetest.domain.demo.TestBubble"
          foreign-key="fk_child_test">
          <meta attribute="bubble-ref"/>
       </many-to-one>




   </class>

</hibernate-mapping>
