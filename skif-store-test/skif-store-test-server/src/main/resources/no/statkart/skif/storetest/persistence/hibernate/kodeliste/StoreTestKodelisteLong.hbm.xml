<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.kodeliste.StoreTestKodelisteLong" table="Kodeliste" lazy="true">
        <!-- Her er det mulig å bruke *KodelisteStringIdType istedet hvis kodelistene skal ha streng baserte id'er -->
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.kodeliste.StoreTestKodelisteLongIdType">
            <generator class="assigned"/>
        </id>

        <property name="kodeTypeNavn" column="kodeTypeNavn" type="string"/>
        <property name="kodeIdClass" column="kodeIdClassname" type="org.hibernate.type.ClassType"/>

        <map name="localizationMap" table="KodelisteLoc" lazy="true" fetch="join">
            <key column="id"/>
            <composite-map-key class="no.statkart.skif.store.localization.LocalizationMap$LocalizationKey">
                <key-property name="locale"/>
                <key-property name="name"/>
            </composite-map-key>
            <element column="value" type="java.lang.String"/>
        </map>

    </class>

</hibernate-mapping>
