<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.koder.XStrDbKode" table="XStrKode" lazy="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.kodeliste.XStrDbKodeIdType">
            <generator class="assigned"/>
        </id>

        <property name="kodeverdi"/>

        <map name="localizationMap" table="XStrKodeLoc" lazy="true" fetch="join">
            <key column="id"/>
            <composite-map-key class="no.statkart.skif.store.localization.LocalizationMap$LocalizationKey">
                <key-property name="locale"/>
                <key-property name="name"/>
            </composite-map-key>
            <element column="value" type="java.lang.String"/>
        </map>

    </class>

</hibernate-mapping>
