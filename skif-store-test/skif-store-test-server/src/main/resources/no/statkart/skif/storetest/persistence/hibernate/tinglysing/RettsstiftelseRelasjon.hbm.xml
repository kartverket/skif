<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.tinglysing.RettsstiftelseRelasjon" lazy="true" abstract="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.tinglysing.RettsstiftelseRelasjonIdType">
            <generator class="assigned"/>
        </id>

        <many-to-one
              name="rettsstiftelseId"
              column="rettsstiftelseId"
              class="no.statkart.skif.storetest.domain.tinglysing.Rettsstiftelse"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_Relasjon_Rettsstift">
           <meta attribute="bubble-ref"/>
        </many-to-one>

        <set name="andelKoblinger" table="Relasjon_Andel_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.RettsstiftelseRelasjonTilAndelKobling">
                <property name="rolle"/>
                <many-to-one
                      name="andelId"
                      column="andelId"
                      class="no.statkart.skif.storetest.domain.tinglysing.AndelIMatrikkelenhet"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Relasjon_Andel">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

        <set name="nivaaKoblinger" table="Relasjon_Nivaa_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.RettsstiftelseRelasjonTilNivaaKobling">
                <property name="rolle"/>
                <many-to-one
                      name="nivaaId"
                      column="nivaaId"
                      class="no.statkart.skif.storetest.domain.tinglysing.NivaaIMatrikkelenhet"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Relasjon_Nivaa">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

    </class>

</hibernate-mapping>
