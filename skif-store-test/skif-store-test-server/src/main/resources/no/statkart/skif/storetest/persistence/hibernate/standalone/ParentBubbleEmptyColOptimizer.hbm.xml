<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.standalone.ParentBubbleEmptyColOptimizer" lazy="true" discriminator-value="ParentBubbleEmptyColOptimizer">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.standalone.ParentBubbleEmptyColOptimizerIdType">
            <generator class="assigned"/>
        </id>
        <discriminator column="class" type="string"/>

        <!-- Flagg som brukes til å holde styr på hvilke collections i boble som er tomme og som derfor kan initialiseres uten å gå til databasen -->
        <property name="emptyCollectionsFlag" access="field">
            <type name="no.statkart.skif.persistence.hibernate.type.EmptyCollectionsOptimizerFlagType">
                <param name="bit.0">
                    no.statkart.skif.storetest.domain.standalone.ParentBubbleEmptyColOptimizer.children1
                </param>
                <param name="bit.1">
                    no.statkart.skif.storetest.domain.standalone.ParentBubbleEmptyColOptimizer.children2
                </param>
                <param name="bit.2">
                    no.statkart.skif.storetest.domain.standalone.ParentBubbleEmptyColOptimizerSub1.children4
                </param>
            </type>
        </property>
        <set name="children1" access="field" lazy="true" batch-size="256">
            <meta attribute="bubble-ref"/>
            <key column="parent1Id"/>
            <one-to-many  class="no.statkart.skif.storetest.domain.standalone.ChildBubbleEmptyColOptimizer"/>
        </set>
        <set name="children2" access="field" lazy="true" batch-size="256">
            <meta attribute="bubble-ref"/>
            <key column="parent2Id"/>
            <one-to-many  class="no.statkart.skif.storetest.domain.standalone.ChildBubbleEmptyColOptimizer"/>
        </set>
        <set name="children3" access="field" lazy="true" batch-size="256">
            <meta attribute="bubble-ref"/>
            <key column="parent3Id"/>
            <one-to-many  class="no.statkart.skif.storetest.domain.standalone.ChildBubbleEmptyColOptimizer"/>
        </set>
        <property name="text"/>


        <subclass name="no.statkart.skif.storetest.domain.standalone.ParentBubbleEmptyColOptimizerSub1" discriminator-value="ParentBubbleEmptyColOptimizerSub1" lazy="true">
            <set name="children4" access="field" lazy="true" batch-size="256">
                <meta attribute="bubble-ref"/>
                <key column="parent4Id"/>
                <one-to-many  class="no.statkart.skif.storetest.domain.standalone.ChildBubbleEmptyColOptimizer"/>
            </set>
        </subclass>
    </class>



</hibernate-mapping>
