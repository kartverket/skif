<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false" >

    <class name="no.statkart.skif.storetest.domain.basic.BubbleWithAnyBubbleRef" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.basic.BubbleWithAnyBubbleRefIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="anyId" type="no.statkart.skif.store.persistence.hibernate.type.AnyBubbleIdType">
            <column name="anyId"/>
<!--            <column name="anyIdClass"/>-->
        </property>

        <component name="someIdent" class="no.statkart.skif.store.persistence.hibernate.type.AnyConcatenatedFieldsEmbeddable">
<!--            TODO: det er noe rundt rekkefølge som må sees på-->
            <property name="value" column="someIdentValue"/>
            <property name="className" column="someIdentClass"/>
        </component>
    </class>
</hibernate-mapping>
