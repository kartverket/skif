<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.basic.BubbleWithAnyBubbleRef" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.basic.BubbleWithAnyBubbleRefIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="anyId" type="no.statkart.skif.store.persistence.hibernate.type.AnyBubbleIdType">
            <column name="anyId"/>
            <column name="anyIdClass"/>
        </property>

        <property name="someIdent" type="no.statkart.skif.store.persistence.hibernate.type.AnyConcatenatedFieldsType">
            <column name="someIdentValue"/>
            <column name="someIdentClass"/>
        </property>
    </class>
</hibernate-mapping>
