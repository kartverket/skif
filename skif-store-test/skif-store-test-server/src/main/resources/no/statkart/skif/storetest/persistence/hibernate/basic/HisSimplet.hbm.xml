<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false" >

    <class name="no.statkart.skif.storetest.domain.basic.HistSimple" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.basic.HistSimpleIdType">
            <generator class="assigned"/>
        </id>

        <!-- historikk felter begin -->
        <property name="oppdateringsdato" type="timestamp" update="false" />
        <property name="sluttdato" type="timestamp" update="false"/>
        <property name="versjonId" type="long" update="false"/>
        <!-- historikk felter end -->

        <property name="nr"/>
        <property name="text"/>
        <property name="testSetNumber"/>

    </class>
</hibernate-mapping>
