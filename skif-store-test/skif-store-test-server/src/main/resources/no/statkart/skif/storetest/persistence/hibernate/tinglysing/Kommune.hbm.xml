<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.tinglysing.Kommune" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.tinglysing.KommuneIdType">
            <generator class="assigned"/>
        </id>
        <property name="kommunenummer" type="string" not-null="true"/>
        <property name="navn" type="string" not-null="true"/>
        <many-to-one
              name="embeteId"
              column="embeteId"
              class="no.statkart.skif.storetest.domain.tinglysing.Embete"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_Kommune_Embete">
           <meta attribute="bubble-ref"/>
        </many-to-one>
    </class>

</hibernate-mapping>
