<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2AAWithEntityComponent"
           table="X2AAWithEntComp" select-before-update="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.relation.uni.component.entity.X2AAWithEntityComponentIdType">
            <generator class="assigned"/>
        </id>

        <property name="nr"/>
        <property name="text"/>

        <many-to-one
                name="entityComponentOne"
                column="entityComponentOneId"
                class="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2EntityComponentOne"
                access="field"
                fetch="join"
                unique="true"
                cascade="all-delete-orphan">
        </many-to-one>

        <set name="aaSetEntityComponentsSet" lazy="true" cascade="all-delete-orphan,evict" batch-size="256">
            <key column="ownerId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2SetEntityComponent"/>
        </set>

    </class>

    <class name="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2EntityComponentOne" lazy="true"
           select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>
        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2AAWithEntityComponent"
                access="field"
                cascade="none">
        </many-to-one>

        <property name="text"/>

        <property name="someBBId"
                  type="no.statkart.skif.storetest.persistence.hibernate.type.relation.uni.component.entity.X2BBOneIdType"/>

        <!--suppress HibernateMappingDomInspection -->
        <set name="someCCsIdsSet" lazy="true" batch-size="256" table="X2AAForX2CCMany">
            <key column="ownerId"/>
            <element column="childId" type="no.statkart.skif.storetest.persistence.hibernate.type.relation.uni.component.entity.X2CCManyIdType" />
        </set>

    </class>

    <class name="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2SetEntityComponent" table="X2SetEntityComp"
           lazy="true" select-before-update="true">
        <id name="id" unsaved-value="null">
            <generator class="no.statkart.skif.service.sequence.HighLowGenerator"/>
        </id>

        <!-- readonly tilbakepeker som settes av one-to-many collection mapping i owner  -->
        <many-to-one
                name="owner"
                column="ownerId"
                class="no.statkart.skif.storetest.domain.relation.uni.component.entity.X2AAWithEntityComponent"
                access="field"
                update="false"
                insert="false"
                cascade="none">
        </many-to-one>

        <property name="text"/>

        <property name="role1BBOneId"
                  type="no.statkart.skif.storetest.persistence.hibernate.type.relation.uni.component.entity.X2BBOneIdType"/>

    </class>

</hibernate-mapping>
