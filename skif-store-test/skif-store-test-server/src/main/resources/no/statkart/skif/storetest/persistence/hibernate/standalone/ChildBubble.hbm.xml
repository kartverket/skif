<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.standalone.ChildBubble" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.standalone.ChildBubbleIdType">
            <generator class="assigned"/>
        </id>

        <property name="text"/>

        <many-to-one
                name="testBubble"
                column="testBubbleId"
                class="no.statkart.skif.storetest.domain.standalone.TestBubble"
                foreign-key="fk_child_test">
            <meta attribute="bubble-ref"/>
        </many-to-one>


    </class>

</hibernate-mapping>
