<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.tinglysing.Matrikkelenhet" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.tinglysing.MatrikkelenhetIdType">
            <generator class="assigned"/>
        </id>
        <many-to-one
              name="kommuneId"
              column="kommuneId"
              class="no.statkart.skif.storetest.domain.tinglysing.Kommune"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_Matrikkelenhet_Kommune">
           <meta attribute="bubble-ref"/>
        </many-to-one>
        <property name="gaardsnummer" type="int" not-null="true"/>
        <property name="bruksnummer" type="int" not-null="true"/>
        <property name="festenummer" type="int" not-null="true"/>
        <property name="seksjonsnummer" type="int" not-null="true"/>
    </class>

</hibernate-mapping>
