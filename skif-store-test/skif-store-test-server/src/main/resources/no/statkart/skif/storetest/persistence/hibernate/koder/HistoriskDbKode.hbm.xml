<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.koder.HistoriskDbKode" table="HistoriskDbKode">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.koder.HistoriskDbKodeIdType">
            <generator class="assigned"/>
        </id>

        <discriminator column="class" type="string"/>

        <property name="kodeverdi"/>

        <!-- For øyeblikket er alle StoreTest-koder lokalisert, siden de var det i forrige revisjon. Mapper derfor lokaliseringen allerede her. -->
        <map name="localizationMap" table="HistoriskDbKodeLoc" lazy="true" fetch="join">
            <key column="id"/>
            <composite-map-key class="no.statkart.skif.store.localization.LocalizationMap$LocalizationKey">
                <key-property name="locale" type="no.statkart.skif.store.persistence.hibernate.type.LocaleType"/>
                <key-property name="name"/>
            </composite-map-key>
            <element column="value" type="java.lang.String"/>
        </map>

        <subclass name="no.statkart.skif.storetest.domain.koder.SimpleLocalizedDbKode" discriminator-value="SimpleLocalizedDbKode">
        </subclass>
    </class>

</hibernate-mapping>
