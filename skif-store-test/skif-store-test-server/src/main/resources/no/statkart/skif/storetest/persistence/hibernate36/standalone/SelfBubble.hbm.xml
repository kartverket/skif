<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

   <class name="no.statkart.skif.storetest.domain.standalone.SelfBubble" select-before-update="true">
      <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.standalone.SelfBubbleIdType">
          <generator class="assigned"/>
      </id>

      <property name="text"/>

       <many-to-one
          name="ref"
          column="refId"
          class="no.statkart.skif.storetest.domain.standalone.SelfBubble">
          <meta attribute="bubble-ref"/>
       </many-to-one>

   </class>

</hibernate-mapping>
