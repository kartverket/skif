<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.tinglysing.Rettsstiftelse" lazy="true" abstract="true">
        <id name="id" column="id"
            type="no.statkart.skif.storetest.persistence.hibernate.type.tinglysing.RettsstiftelseIdType">
            <generator class="assigned"/>
        </id>

        <discriminator column="class"/>

        <property name="rettsstiftelsesnummer" type="int" not-null="true"/>

        <many-to-one
              name="dokumentId"
              column="dokumentId"
              class="no.statkart.skif.storetest.domain.tinglysing.Dokument"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_Rettsstift_Dokument">
           <meta attribute="bubble-ref"/>
        </many-to-one>

        <many-to-one
              name="rettsstiftelsestypeKodeId"
              column="rettsstiftelsestypeKodeId"
              class="no.statkart.skif.storetest.domain.tinglysing.RettsstiftelsestypeKode"
              access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
              foreign-key="FK_Rettsstift_Rettsstiftelsestype">
           <meta attribute="bubble-ref"/>
        </many-to-one>

        <set name="beloep" table="beloep" access="property" lazy="false" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.Beloep">
                <property name="rolle"/>
                <property name="beloepsverdi" type="big_decimal" not-null="true"/>
                <property name="valuta" type="string" not-null="true"/>
                <property name="beloepstekst" type="string"/>
            </composite-element>
        </set>

        <set name="personKoblinger" table="Rettsstiftelse_Person_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.RettsstiftelseTilPersonKobling">
                <property name="rolle"/>
                <many-to-one
                      name="personId"
                      column="personId"
                      class="no.statkart.skif.storetest.domain.tinglysing.Person"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Rettsstift_Person">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

        <set name="andelKoblinger" table="Rettsstiftelse_Andel_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.RettsstiftelseTilAndelKobling">
                <property name="rolle"/>
                <many-to-one
                      name="andelId"
                      column="andelId"
                      class="no.statkart.skif.storetest.domain.tinglysing.AndelIMatrikkelenhet"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Rettsstift_Andel">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

        <set name="relasjonKoblinger" table="Rettsst_Relasjon_Kobling" cascade="all,delete-orphan">
            <key column="rettsstiftelseId"/>
            <composite-element class="no.statkart.skif.storetest.domain.tinglysing.kobling.RettsstiftelseTilRelasjonKobling">
                <property name="rolle"/>
                <many-to-one
                      name="relasjonId"
                      column="relasjonId"
                      class="no.statkart.skif.storetest.domain.tinglysing.RettsstiftelseRelasjon"
                      access="no.statkart.skif.store.persistence.hibernate.bubbleref.BubbleRefFieldAccessor"
                      foreign-key="FK_Rettsstift_Relasjon">
                   <meta attribute="bubble-ref"/>
                </many-to-one>
            </composite-element>
        </set>

        <subclass name="no.statkart.skif.storetest.domain.tinglysing.HjemmelForPerson" discriminator-value="Hjemmel" lazy="true">
        </subclass>
    </class>

</hibernate-mapping>
