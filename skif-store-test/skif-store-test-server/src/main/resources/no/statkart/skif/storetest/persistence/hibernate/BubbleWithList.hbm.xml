<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false" auto-import="false">

    <class name="no.statkart.skif.storetest.domain.demo.BubbleWithList" select-before-update="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.BubbleWithListIdType">
            <generator class="assigned"/>
        </id>

        <property name="text"/>

        <set name="otherBWLIds" table="BWLForBWL" lazy="true" batch-size="256" access="field">
            <key column="underBWLId"/>
            <element column="bwlId"
                     type="no.statkart.skif.storetest.persistence.hibernate.type.BubbleWithListIdType"/>
        </set>


        <set name="components" lazy="true" cascade="all-delete-orphan,evict" batch-size="256" access="field" inverse="true">
            <key column="bubbleWithListId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.demo.BubbleWithListComponent"/>
        </set>

        <set name="components2" lazy="true" cascade="all-delete-orphan,evict" batch-size="256" access="field" inverse="true">
            <key column="bubbleWithListId"/>
            <one-to-many class="no.statkart.skif.storetest.domain.demo.BubbleWithListComponent2"/>
        </set>

    </class>

    <class name="no.statkart.skif.storetest.domain.demo.BubbleWithListComponent" lazy="true"
           select-before-update="true">
        <id name="id" column="id">
            <generator class="assigned"/>
        </id>

        <property name="componentName"/>
        <many-to-one name="bubbleWithList" class="no.statkart.skif.storetest.domain.demo.BubbleWithList"
                     column="bubbleWithListId" not-null="true"/>

        <property name="oppdateringsdato" type="timestamp" update="false" insert="false"/>
        <property name="sluttdato" type="timestamp" update="false" insert="false"/>
        <property name="versjonId" type="long" update="false" insert="false"/>


        <property name="aEnumKodeId" type="Demo_AEnumKodeIdType"/>

    </class>

    <class name="no.statkart.skif.storetest.domain.demo.BubbleWithListComponent2" lazy="true"
           select-before-update="true">
        <id name="id" column="id">
            <generator class="assigned"/>
        </id>

        <property name="componentName"/>
        <many-to-one name="bubbleWithList" class="no.statkart.skif.storetest.domain.demo.BubbleWithList"
                     column="bubbleWithListId" not-null="true"/>

        <property name="oppdateringsdato" type="timestamp" update="false" insert="false"/>
        <property name="sluttdato" type="timestamp" update="false" insert="false"/>
        <property name="versjonId" type="long" update="false" insert="false"/>

    </class>

</hibernate-mapping>
