<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping
    xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping https://www.hibernate.org/xsd/hibernate-mapping-4.0.xsd"
    default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.koder.CDbKode" table="CKode" lazy="true">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.kodeliste.CDbKodeIdType">
            <generator class="assigned"/>
        </id>
        <discriminator column="class" type="string"/>

        <property name="kodeverdi"/>

        <map name="localizationMap" table="CKodeLoc" lazy="true" fetch="join">
            <key column="id"/>
            <composite-map-key class="no.statkart.skif.store.localization.LocalizationMap$LocalizationKey">
                <key-property name="locale"/>
                <key-property name="name"/>
            </composite-map-key>
            <element column="value" type="java.lang.String"/>
        </map>

        <subclass name="no.statkart.skif.storetest.domain.demo.koder.C1DbKode"
                  discriminator-value="C1DbKode" lazy="true">
        </subclass>
        <subclass name="no.statkart.skif.storetest.domain.demo.koder.C2DbKode"
                  discriminator-value="C2DbKode" lazy="true">
        </subclass>

    </class>

</hibernate-mapping>
