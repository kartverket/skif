<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE hibernate-mapping SYSTEM "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.koder.CDbKode" table="CKode">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.kodeliste.CDbKodeIdType">
            <generator class="assigned"/>
        </id>
        <discriminator column="class" type="string"/>

        <property name="kodeverdi"/>

        <map name="localizedFieldsMap" table="CKodeLoc">
            <key column="id"/>
            <map-key type="string" column="lokale"/>
            <composite-element class="no.statkart.skif.store.kodeliste.Kode$LocalizedFields">
                <property name="navn" type="string" access="field"/>
                <property name="beskrivelse" type="string" access="field"/>
           </composite-element>
        </map>

        <subclass name="no.statkart.skif.storetest.domain.demo.koder.C1DbKode"
                  discriminator-value="C1DbKode" lazy="true">
        </subclass>
        <subclass name="no.statkart.skif.storetest.domain.demo.koder.C2DbKode"
                  discriminator-value="C2DbKode" lazy="true">
        </subclass>

    </class>

</hibernate-mapping>
