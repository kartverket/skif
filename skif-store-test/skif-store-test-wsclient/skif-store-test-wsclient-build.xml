<project>
    <target name="wsClientFixExceptions">
        <_ws-client-fix-exceptions
                name="skif-service-test"
                exception.package.import="import no.statkart.skif.storetest.wsapi.exception.*;"
                exception.package.dir="${wsTargetDir}/no/statkart/skif/storetest/wsapi/exception"
                exception.file.pattern="**/wsapi/service/**/*Exception.java"
                regexp.match="package no\.statkart\.skif\.storetest\.wsapi\.service(\..+)*;"
                regexp.replace="package no\.statkart\.skif\.storetest\.wsapi\.exception;"
                />
    </target>

    <!-- Fix wrongly mapped Web service exceptions: The should all go into package specified by the schema namespace for the exception and not in the service package -->
    <macrodef name="_ws-client-fix-exceptions"
              description="Fix wrongly mapped Web service exceptions for a spesific API">
        <attribute name="name" description="Display name of webservice module"/>
        <attribute name="exception.package.dir" description="Destination package for *Exception.java files"/>
        <attribute name="exception.package.import" description="Import statement package for *Exception.java files"/>
        <attribute name="exception.file.pattern" description="pattern for moving *Exception.java files"/>
        <attribute name="regexp.match" description="Matching pattern for string replacement in moved source file"/>
        <attribute name="regexp.replace" description="Replacement pattern for string replacement in moved source file"/>

        <sequential>
            <echo>Fixing wrongly placed Web service exceptions for @{name}...</echo>

            <!-- Move exceptions -->
            <mkdir dir="@{exception.package.dir}"/>
            <move todir="@{exception.package.dir}" overwrite="true" flatten="true" failonerror="true" verbose="true">
                <fileset dir="${wsTargetDir}">
                    <include name="@{exception.file.pattern}"/>
                </fileset>
            </move>


            <!-- Fix package name for moved exceptions -->
            <replaceregexp
                    match="@{regexp.match}"
                    replace="@{regexp.replace}">
                <fileset dir="@{exception.package.dir}">
                    <include name="*Exception.java"/>
                </fileset>
            </replaceregexp>

            <!-- Add an import statement mapDomainObject Web service interfaces -->
            <replaceregexp>
                <regexp pattern="package (.+);"/>
                <substitution
                        expression="package \1;${line.separator}${line.separator}@{exception.package.import}"/>
                <fileset dir="@{exception.package.dir}/../service"
                         erroronmissingdir="true">
                    <include name="**/*Service*.java"/>
                </fileset>
            </replaceregexp>
        </sequential>
    </macrodef>
</project>