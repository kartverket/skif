<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-cascade="none" default-lazy="false">

    <class name="no.statkart.skif.storetest.domain.demo.Test">
        <id name="id" column="id" type="no.statkart.skif.storetest.persistence.hibernate.type.mockup.BarIdType">
            <generator class="assigned"/>
        </id>

        <property name="husnr"/>
        <property name="bokstav"/>
        <many-to-one
           name="foo"
           column="fooId"
           class="no.statkart.skif.storetest.domain.mockup.Foo">
           <meta attribute="bubble-ref"/>
        </many-to-one>
        <many-to-one
           name="baz"
           column="bazId"
           class="no.statkart.skif.storetest.domain.demo.Baz">
           <meta attribute="bubble-ref"/>
        </many-to-one>

    </class>

</hibernate-mapping>
