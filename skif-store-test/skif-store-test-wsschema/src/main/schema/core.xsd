<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        version="1.0"
        targetNamespace="http://skif.statkart.no/storetest/wsapi/domain"
        xmlns:corens="http://skif.statkart.no/storetest/wsapi/domain"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <!-- ================================================= -->
    <!-- Basisklasser                                      -->
    <!-- ================================================= -->

    <xs:complexType name="StoreTestBubbleId">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
            <xs:element name="snapshotVersion" type="corens:SnapshotVersion"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="corens:StoreTestBubbleId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleIdListForStoreTestBubbleIdsMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="corens:StoreTestBubbleId"/>
                        <xs:element name="value" type="corens:StoreTestBubbleIdList"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubble">
        <xs:sequence>
            <xs:element name="id" type="corens:StoreTestBubbleId"/>
            <xs:element name="version" type="xs:long"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestBubbleList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="corens:StoreTestBubble"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StoreTestContext">
        <xs:sequence>
            <xs:element name="systemVersion" type="xs:string"/>
            <xs:element name="locale" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SnapshotVersion">
        <xs:sequence>
            <xs:element name="time" type="xs:long"/>
            <xs:element name="nanos" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Timestamp">
        <xs:sequence>
            <xs:element name="time" type="xs:long"/>
            <xs:element name="nanos" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
